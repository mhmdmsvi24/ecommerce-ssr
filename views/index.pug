extends layout

block content
    include components/product-card
    include components/ui/button
    header.container
        .header__tagline
            h1 Access High Quality, <br/> <span>Eco-Friendly</span> Products <br/> and services
                div
                    <img src="/icons/arrow-right-long.svg" />
                    +button("Contact Us", "btn-fill")

        .header__customers
            .hc__images
                img(src="/images/customers/profile-image-1.jpeg")
                img(src="/images/customers/profile-image-2.jpeg")
                img(src="/images/customers/profile-image-3.jpeg")
            .hc__text
                .l1 500+
                .l2 Happy Customers
    ul.pc__wrapper.carousel.container
        each product in products
            li
                +productCard(product)
