include ./button

mixin productCard(product)
    article.product__card
        img(src=product.img, alt=product.desc, draggable="false").pc__bg
        div.pc__header
            div.pc__like
                img(src="/icons/heart.svg", width="24")
            div.pc__link
                +button("Buy Now")
        div.pc__separator
        div.pc__footer
            div.pc__desc= product.desc
